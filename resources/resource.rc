#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

// DPI 感知 manifest — 防止高 DPI 下字体模糊
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APPICON ICON "icon.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开固件(&O)\tCtrl+O",    IDM_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                IDM_FILE_EXIT
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A)",                IDM_HELP_ABOUT
    END
END

IDR_MAINACCEL ACCELERATORS
BEGIN
    "O", IDM_FILE_OPEN, CONTROL, VIRTKEY
END

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,2,0
PRODUCTVERSION  0,1,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "kabirz"
            VALUE "FileDescription",  "CAN/UART 调试工具"
            VALUE "FileVersion",      "0.1.1.0"
            VALUE "InternalName",     "can-uart-tool"
            VALUE "LegalCopyright",   "Copyright © 2025 kabirz"
            VALUE "OriginalFilename", "can-uart-tool.exe"
            VALUE "ProductName",      "CAN/UART 工具"
            VALUE "ProductVersion",   "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
