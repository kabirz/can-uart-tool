# Normalize line endings: LF in repository, platform-native in working tree
* text=auto

# Source code — LF in repo
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.rc text eol=lf
*.manifest text eol=lf

# Documentation — LF in repo
*.md text eol=lf
*.txt text eol=lf

# Build system — LF in repo
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# YAML — LF in repo
*.yml text eol=lf

# Binary files
*.ico binary
